<?xml version="1.0" encoding="utf-8"?>
<!-- Optional VSTest collector. Primary Cobertura for CI: Coverlet.MSBuild on WhiteboxMetrix.Tests → TestResults/coverage/coverage.cobertura.xml -->
<RunSettings>
  <RunConfiguration>
    <TreatNoTestsAsError>false</TreatNoTestsAsError>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,json</Format>
          <Exclude>[WhiteboxMetrix.Tests]*,[xunit.*]*</Exclude>
          <Include>[WhiteboxMetrix]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
